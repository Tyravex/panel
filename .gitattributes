# Normalize text files and use LF across platforms.
* text=auto

*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sql text eol=lf
*.prisma text eol=lf
*.sh text eol=lf

# Windows PowerShell scripts may use CRLF.
*.ps1 text eol=crlf

# Keep binary files unchanged.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary
*.pdf binary
*.woff binary
*.woff2 binary