// Prisma Client is generated for the CommonJS backend runtime.
generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
}

// PostgreSQL connection URL is supplied by the Prisma runtime configuration.
datasource db {
  provider = "postgresql"
}

// =============================================================================
// Identity and access management
// =============================================================================

// Panel account. Global roles and service membership are separate access paths.
model User {
  id        Int     @id @default(autoincrement())
  username  String  @unique
  email     String  @unique
  // Password hash only; never store a plaintext password.
  password  String
  isActive  Boolean @default(true)
  firstName String?
  lastName  String?

  avatar   String?
  language String  @default("en")

  // Global permissions are granted through roles, not service ownership.
  roles     UserRole[]
  sessions  Session[]
  auditLogs AdminAuditLog[]

  notifications      Notification[]
  servers            Server[]
  serverMemberships  ServerMember[]
  services           Service[]
  serviceMemberships ServiceMember[]
  jobs               Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Named collection of global permissions assigned to users.
model Role {
  id   String @id @default(cuid())
  name String @unique

  permissions Permission[]
  users       UserRole[]
}

// Explicit many-to-many role assignment with an audit-friendly timestamp.
model UserRole {
  userId Int
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
}

// Individual global capability; role membership controls its grant.
model Permission {
  id   String @id @default(cuid())
  name String @unique

  roles Role[]
}

// =============================================================================
// Authentication sessions
// =============================================================================

// Revocable login session. JWT validity alone does not guarantee access.
model Session {
  id String @id @default(cuid())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Revocation and expiration must be checked on authenticated requests.
  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

// =============================================================================
// Notifications
// =============================================================================

// User-facing notification persisted independently of realtime delivery.
model Notification {
  id      Int     @id @default(autoincrement())
  content String
  read    Boolean @default(false)

  userId Int
  user   User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

// =============================================================================
// Infrastructure and nodes
// =============================================================================

// Administrative or observed state; not proof of an active WebSocket session.
enum NodeStatus {
  OFFLINE
  ONLINE
  MAINTENANCE
}

// Physical or virtual host authenticated independently by the Agent.
model Node {
  id     String     @id @default(cuid())
  name   String
  status NodeStatus @default(OFFLINE)

  // Store only a token hash; plaintext Agent tokens must not enter the database.
  tokenHash String @unique

  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  services Service[]

  @@index([status])
}

// =============================================================================
// Service catalog
// =============================================================================

// Extensible type of hosted workload (server, Discord bot, Telegram bot, etc.).
model ServiceCategory {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?

  services Service[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Service provisioning lifecycle, separate from individual Job states.
enum ServiceInstallStatus {
  DRAFT
  PENDING_INSTALL
  INSTALLING
  INSTALLED
  FAILED
}

// Canonical hosted workload. New functionality must target Service, not Server.
model Service {
  id   String @id @default(cuid())
  name String

  // Ownership may be unset until the service is assigned.
  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  categoryId String
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Node assignment is optional before provisioning.
  nodeId String?
  node   Node?   @relation(fields: [nodeId], references: [id], onDelete: Restrict)

  // Optional limits preserve compatibility with older service records.
  memoryMb   Int?
  cpuPercent Int?
  diskMb     Int?

  installStatus ServiceInstallStatus @default(DRAFT)

  // Resolved image for the installation.
  // The selected Egg is the source of installation configuration.
  dockerImage String?

  // Selected, versioned installation Egg.
  eggId String?
  egg   Egg?    @relation(fields: [eggId], references: [id], onDelete: Restrict)

  // Temporary compatibility with the legacy Server model.
  // Remove only after all old server functionality has been migrated.
  serverId Int?    @unique
  server   Server? @relation(fields: [serverId], references: [id], onDelete: SetNull)

  members ServiceMember[]
  jobs    Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nodeId])
  @@index([installStatus])
  @@index([userId, categoryId])
  @@index([categoryId])
  @@index([eggId])
}

// =============================================================================
// Service-specific access control
// =============================================================================

// Service-scoped access grants; independent of global role permissions.
model ServiceMember {
  id String @id @default(cuid())

  serviceId String
  userId    Int

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Explicit permission keys granted to this member.
  permissions String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceId, userId])
  @@index([userId])
}

// =============================================================================
// Egg repositories and installation templates
// =============================================================================

// A configured source of installation Eggs.
// Repository contents are not trusted automatically.
enum EggRepositoryStatus {
  ENABLED
  DISABLED
}

// Repository registry. ENABLED alone does not approve every contained Egg.
model EggRepository {
  id String @id @default(cuid())

  name String
  // Source URL is metadata; imports still require validation.
  url  String @unique

  // Metadata only. This does not grant automatic trust.
  isOfficial Boolean             @default(false)
  status     EggRepositoryStatus @default(DISABLED)

  eggs Egg[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// A versioned installation definition imported from a repository.
// The manifest is data, not executable backend plugin code.
model Egg {
  id String @id @default(cuid())

  key         String
  name        String
  description String?
  version     String

  // The importer must validate this document before storing it.
  manifest Json

  repositoryId String
  repository   EggRepository @relation(fields: [repositoryId], references: [id], onDelete: Restrict)

  // Administrator approval is required before an Egg can be selected.
  isEnabled Boolean @default(false)

  services Service[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Different versions of the same Egg can coexist in one repository.
  @@unique([repositoryId, key, version])
  @@index([repositoryId, isEnabled])
}

// =============================================================================
// Legacy hosted servers
// =============================================================================

// Compatibility only. New hosting functionality must use Service.
// Legacy model retained until existing server routes and jobs are migrated.
model Server {
  id   Int    @id @default(autoincrement())
  name String

  status  String @default("offline")
  cpu     Int    @default(0)
  ram     Int    @default(0)
  players Int    @default(0)

  userId  Int
  user    User           @relation(fields: [userId], references: [id])
  members ServerMember[]

  service Service?
  jobs    Job[]

  createdAt DateTime @default(now())
}

// =============================================================================
// Legacy server-specific access control
// =============================================================================

// Legacy Server-scoped permissions; do not use for new Service authorization.
model ServerMember {
  id String @id @default(cuid())

  serverId Int
  userId   Int

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Explicit permission keys granted to this member.
  permissions String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serverId, userId])
  @@index([userId])
}

// =============================================================================
// Background jobs
// =============================================================================

// Job operations are queued work requests, not direct Agent instructions.
enum JobType {
  INSTALL
  BACKUP
  RESTART
  REINSTALL
}

// Job status is distinct from AgentCommandStatus and ServiceInstallStatus.
enum JobStatus {
  PENDING
  DISPATCHING
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// Persistent state of a command sent to an Agent.
// UNKNOWN means execution may have occurred but the result is unconfirmed.
enum AgentCommandStatus {
  PREPARED
  SENT
  ACCEPTED
  COMPLETED
  FAILED
  UNKNOWN
}

// Durable user-requested operation. INSTALL uses an immutable configuration snapshot.
model Job {
  id       String    @id @default(cuid())
  type     JobType
  status   JobStatus @default(PENDING)
  progress Int       @default(0)

  // Immutable installation configuration captured when the job is created.
  // Secret values must never be stored in this field.
  installConfig Json?

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Legacy relation; no new functionality should depend on it.
  serverId Int?
  server   Server? @relation(fields: [serverId], references: [id], onDelete: SetNull)

  // Canonical relation for new hosting jobs.
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  // Commands issued to an Agent for this job.
  // A Job may retain command history; INSTALL command uniqueness is enforced by key.
  agentCommands AgentCommand[]

  // Legacy queue dispatch metadata; not proof that an Agent executed work.
  queueJobId        String?   @unique
  dispatchClaimedAt DateTime?

  // Only sanitized errors may be exposed to users or persisted.
  errorMessage String? @db.Text

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([userId, createdAt])
  @@index([serverId, createdAt])
  @@index([serviceId, createdAt])
  @@index([status, createdAt, id])
}

// =============================================================================
// Persistent Agent commands
// =============================================================================

// This record is the durable identity of an Agent operation.
// Never treat a timeout or disconnect as proof that execution failed.
// Persistent transport command record, not an execution guarantee.
// Dispatch must use atomic state transitions and must not retry UNKNOWN blindly.
model AgentCommand {
  id String @id @default(cuid())

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Restrict)

  // Target and operation are captured when the command is prepared.
  nodeId    String
  serviceId String
  operation String

  // PREPARED is not sent; SENT/ACCEPTED may already be executing remotely.
  status AgentCommandStatus @default(PREPARED)

  // Connection metadata, not the authentication token.
  sessionId String?

  // Timestamps document observed transitions, not remote execution certainty.
  preparedAt DateTime  @default(now())
  sentAt     DateTime?
  acceptedAt DateTime?
  finishedAt DateTime?

  // Sanitized diagnostic information only.
  errorCode    String?
  // Only sanitized errors may be exposed to users or persisted.
  errorMessage String? @db.Text

  // Example: install:<jobId>.
  // This is a database uniqueness guard, not Agent-side idempotency.
  // Prevents creating another command record for the same INSTALL job.
  jobCommandKey String @unique

  @@index([jobId, status])
  @@index([nodeId, status])
  @@index([status, preparedAt])
}

// =============================================================================
// Panel settings
// =============================================================================

// Persisted instance-level feature switches and settings.
model PanelSetting {
  key          String   @id
  booleanValue Boolean
  updatedAt    DateTime @updatedAt
}

// =============================================================================
// Administrative audit trail
// =============================================================================

// Administrative action history. Never include credentials in metadata.
model AdminAuditLog {
  id String @id @default(cuid())

  // Nullable actor preserves history if an account is removed.
  actorId Int?
  actor   User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  action     String
  targetType String
  targetId   String

  // Never store secrets in audit metadata.
  metadata Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

// =============================================================================
// Language plugins
// =============================================================================

// Available UI language, optionally provided by an installed plugin.
model Language {
  code String @id @db.VarChar(35)
  name String

  pluginId String? @unique
  plugin   Plugin? @relation(fields: [pluginId], references: [id], onDelete: Restrict)

  // Fallback language must remain available when plugins are disabled.
  isBuiltIn  Boolean @default(false)
  isEnabled  Boolean @default(false)
  isFallback Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isEnabled])
}

// =============================================================================
// Plugin registry
// =============================================================================

// Registry category; plugins are not automatically trusted or enabled.
enum PluginType {
  LANGUAGE
  THEME
  INTEGRATION
  BILLING
  NOTIFICATION
  OTHER
}

// DISABLED prevents activation until explicitly approved.
enum PluginStatus {
  INSTALLED
  DISABLED
  FAILED
  INSTALLING
  UNINSTALLING
}

// Installed plugin metadata; storagePath must be constrained by application code.
model Plugin {
  id String @id

  type    PluginType
  version String

  status PluginStatus @default(DISABLED)

  // Relative path only; never use unchecked as an arbitrary filesystem path.
  storagePath          String
  sourceRepository     String?
  uninstallOperationId String? @unique @db.Uuid

  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  languages Language[]

  @@index([type, status])
}
