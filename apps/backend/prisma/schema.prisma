// =============================================================================
// Prisma configuration
// =============================================================================

generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// Identity and access management
// =============================================================================

model User {
  id        Int     @id @default(autoincrement())
  username  String  @unique
  email     String  @unique
  password  String
  isActive  Boolean @default(true)
  firstName String?
  lastName  String?

  avatar   String?
  language String  @default("en")

  // Global panel roles assigned to this user.
  roles     UserRole[]
  sessions  Session[]
  auditLogs AdminAuditLog[]

  notifications      Notification[]
  servers            Server[]
  serverMemberships  ServerMember[]
  services           Service[]
  serviceMemberships ServiceMember[]
  jobs               Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id   String @id @default(cuid())
  name String @unique

  permissions Permission[]
  users       UserRole[]
}

// Explicit membership allows future metadata such as assignedBy and expiresAt.
model UserRole {
  userId Int
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
}

model Permission {
  id   String @id @default(cuid())
  name String @unique

  roles Role[]
}

// =============================================================================
// Authentication sessions
// =============================================================================

// Server-side session used to revoke JWT access before token expiration.
model Session {
  id String @id @default(cuid())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Session validity is checked independently of JWT expiration.
  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

// =============================================================================
// Notifications
// =============================================================================

model Notification {
  id      Int     @id @default(autoincrement())
  content String
  read    Boolean @default(false)

  userId Int
  user   User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

// =============================================================================
// Infrastructure and nodes
// =============================================================================

// Current connectivity or administrative state of a node.
enum NodeStatus {
  OFFLINE
  ONLINE
  MAINTENANCE
}

// A machine running a Tyravex Agent.
// Each node authenticates independently using its own token.
model Node {
  id     String     @id @default(cuid())
  name   String
  status NodeStatus @default(OFFLINE)

  // Store a cryptographic token hash, never the plaintext token.
  tokenHash String @unique

  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  services Service[]

  @@index([status])
}

// =============================================================================
// Service catalog
// =============================================================================

// A configurable category of hosted services.
// Examples include game servers, Discord bots, and Telegram bots.
model ServiceCategory {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?

  services Service[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Installation lifecycle of a hosted service.
enum ServiceInstallStatus {
  DRAFT
  PENDING_INSTALL
  INSTALLING
  INSTALLED
  FAILED
}

// A hosted service that may be unassigned until an administrator assigns an owner.
// Existing servers can be linked without changing their original records.
model Service {
  id   String @id @default(cuid())
  name String

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  categoryId String
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Existing services can remain unassigned until provisioning is configured.
  nodeId String?
  node   Node? @relation(fields: [nodeId], references: [id], onDelete: Restrict)

  // Resource limits are optional for previously created services.
  memoryMb   Int?
  cpuPercent Int?
  diskMb     Int?

  installStatus ServiceInstallStatus @default(DRAFT)

  // Optional reference to an existing hosted server.
  // A server can be linked to at most one service.
  serverId Int?    @unique
  server   Server? @relation(fields: [serverId], references: [id], onDelete: SetNull)

  members ServiceMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nodeId])
  @@index([installStatus])
  @@index([userId, categoryId])
  @@index([categoryId])
}

// =============================================================================
// Service-specific access control
// =============================================================================

// A user invited to manage one service with individually granted permissions.
// The service owner remains defined by Service.userId.
model ServiceMember {
  id String @id @default(cuid())

  serviceId String
  userId    Int

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Service-scoped permissions, independent of global panel roles.
  permissions String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceId, userId])
  @@index([userId])
}

// =============================================================================
// Hosted servers
// =============================================================================

model Server {
  id   Int    @id @default(autoincrement())
  name String

  status  String @default("offline")
  cpu     Int    @default(0)
  ram     Int    @default(0)
  players Int    @default(0)

  userId  Int
  user    User           @relation(fields: [userId], references: [id])
  members ServerMember[]

  // Optional catalog entry for this existing hosted server.
  service Service?

  jobs Job[]

  createdAt DateTime @default(now())
}

// =============================================================================
// Server-specific access control
// =============================================================================

// A user invited to manage a specific server.
// The server owner remains defined by Server.userId.
model ServerMember {
  id String @id @default(cuid())

  serverId Int
  userId   Int

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Server-scoped permissions, independent of global panel roles.
  permissions String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A user can be a member of a server only once.
  @@unique([serverId, userId])
  @@index([userId])
}

// =============================================================================
// Background jobs
// =============================================================================

// Supported background operations in the Tyravex panel.
enum JobType {
  INSTALL
  BACKUP
  RESTART
  REINSTALL
}

// Lifecycle states shared by the API, workers, and UI.
enum JobStatus {
  PENDING
  DISPATCHING
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model Job {
  id       String    @id @default(cuid())
  type     JobType
  status   JobStatus @default(PENDING)
  progress Int       @default(0)

  // User who requested the operation.
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Some operations may not belong to a specific server.
  serverId Int?
  server   Server? @relation(fields: [serverId], references: [id], onDelete: SetNull)

  // BullMQ job reference and dispatcher recovery metadata.
  queueJobId        String?   @unique
  dispatchClaimedAt DateTime?

  // Safe error summary; never store credentials or tokens.
  errorMessage String? @db.Text

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([userId, createdAt])
  @@index([serverId, createdAt])
  @@index([status, createdAt, id])
}

// =============================================================================
// Panel settings
// =============================================================================

// Persisted panel-wide settings. Public registration is disabled by default.
model PanelSetting {
  key          String   @id
  booleanValue Boolean
  updatedAt    DateTime @updatedAt
}

// =============================================================================
// Administrative audit trail
// =============================================================================

model AdminAuditLog {
  id String @id @default(cuid())

  // Administrator who performed the operation.
  actorId Int?
  actor   User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  // Examples: USER_CREATED, USER_DISABLED, ROLE_ASSIGNED.
  action String

  // Resource affected by the operation.
  targetType String
  targetId   String

  // Only explicitly approved, non-sensitive metadata is stored.
  metadata Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

// =============================================================================
// Language plugins
// =============================================================================

// Registry of languages available to the Tyravex panel.
// Language packages are discovered automatically but activated by an admin.
model Language {
  // BCP 47 language tag, e.g. en, pl, de, fr, pt-BR.
  code String @id @db.VarChar(35)

  // Native display name, e.g. English, Polski, Deutsch.
  name String

  // Optional plugin providing this language.
  pluginId String? @unique

  // Built-in languages do not require a plugin.
  plugin Plugin? @relation(fields: [pluginId], references: [id], onDelete: Restrict)

  // Built-in languages are distributed with Tyravex.
  isBuiltIn Boolean @default(false)

  // New language plugins remain disabled until approved.
  isEnabled Boolean @default(false)

  // Prevent removal or disabling of the fallback language.
  isFallback Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isEnabled])
}

// =============================================================================
// Plugin registry
// =============================================================================

// Categories of extensions supported by Tyravex.
enum PluginType {
  LANGUAGE
  THEME
  INTEGRATION
  BILLING
  NOTIFICATION
  OTHER
}

// Installation lifecycle of a plugin on this instance.
enum PluginStatus {
  INSTALLED
  DISABLED
  FAILED
}

// Registry of locally installed plugin packages.
// The plugin files are stored outside the database.
model Plugin {
  // Stable identifier from the plugin manifest.
  id String @id

  type    PluginType
  version String

  // Installation and activation state.
  status PluginStatus @default(DISABLED)

  // Path relative to the managed plugin storage root.
  // Never use this value as an unrestricted filesystem path.
  storagePath String

  // Optional origin information for future catalog integration.
  sourceRepository String?

  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  languages Language[]

  @@index([type, status])
}
