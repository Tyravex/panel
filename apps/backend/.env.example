# =============================================================================
# Application
# =============================================================================

NODE_ENV=development
PORT=3000


# =============================================================================
# PostgreSQL - Local backend
# =============================================================================

DATABASE_URL=postgresql://tyravex:CHANGE_ME@127.0.0.1:5433/tyravex?schema=public


# =============================================================================
# PostgreSQL - Integration tests
# =============================================================================

# Integration tests require a separate, isolated database.
# The database name must be exactly: tyravex_rbac_test
#
# Run PostgreSQL integration tests with DATABASE_URL pointing to:
# DATABASE_URL=postgresql://tyravex:CHANGE_ME@127.0.0.1:5433/tyravex_rbac_test?schema=public
#
# Never run integration tests against the application database.


# =============================================================================
# Redis - Application
# =============================================================================

REDIS_URL=redis://127.0.0.1:6380

# BullMQ uses the fixed queue name: server-operations.
# Worker execution is disabled by default.
# Do not enable it until all server operation handlers are implemented.
JOB_WORKER_ENABLED=false

# =============================================================================
# Redis - Integration tests
# =============================================================================

# Use a dedicated local Redis instance, separate from application Redis.
REDIS_TEST_URL=redis://127.0.0.1:6381


# =============================================================================
# Authentication
# =============================================================================

JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret


# =============================================================================
# CORS
# =============================================================================

CORS_ORIGIN=http://localhost:5173
