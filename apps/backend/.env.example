# =============================================================================
# Application
# =============================================================================

NODE_ENV=development
PORT=3000


# =============================================================================
# PostgreSQL - Local backend
# =============================================================================

DATABASE_URL=postgresql://tyravex:CHANGE_ME@127.0.0.1:5433/tyravex?schema=public


# =============================================================================
# PostgreSQL - Integration tests (local, separate database)
# =============================================================================

# Create this database and user separately. Never point at DATABASE_URL.
# pnpm --filter backend test:database automatically applies Prisma migrations.
TEST_DATABASE_URL=postgresql://tyravex_test:tyravex_test_local_only@127.0.0.1:55433/tyravex_integration?schema=public


# =============================================================================
# Redis - Application
# =============================================================================

REDIS_URL=redis://127.0.0.1:6380

# BullMQ uses the fixed queue name: server-operations.
# Worker execution is disabled by default.
# Do not enable it until all server operation handlers are implemented.
JOB_WORKER_ENABLED=false

# =============================================================================
# Redis - Integration tests
# =============================================================================

# Use a dedicated local Redis instance, separate from application Redis.
REDIS_TEST_URL=redis://127.0.0.1:6381


# =============================================================================
# Authentication
# =============================================================================

JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret


# =============================================================================
# CORS
# =============================================================================

CORS_ORIGIN=http://localhost:5173
