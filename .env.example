# Application
NODE_ENV=development
PORT=3000

# PostgreSQL (Docker Compose)
POSTGRES_USER=tyravex
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=tyravex

# Database (backend running locally on Windows)
DATABASE_URL=postgresql://tyravex:CHANGE_ME@127.0.0.1:5433/tyravex?schema=public

# Redis (Docker Compose)
REDIS_URL=redis://127.0.0.1:6380
QUEUE_NAME=game-tasks

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret

# Frontend
VITE_API_URL=http://localhost:3000

# CORS
CORS_ORIGIN=http://localhost:5173

# Node Agent (planned)
# NODE_AGENT_SHARED_SECRET=replace_with_a_random_secret